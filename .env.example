# Nexora backend configuration (all optional — sensible defaults apply).

# Datastore. Default is SQLite (zero setup). docker-compose overrides this with
# a Postgres URL. Example Postgres: postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=sqlite:///./nexora.db

# CORS: comma-separated origins, or "*".
CORS_ORIGINS=*

# Live-pipeline tuning (optional)
# TICK_SECONDS=0.6
# NORMAL_RATE_PER_TICK=2
# WINDOW_MINUTES=15
# ATTACK_SPREAD_SECONDS=6
